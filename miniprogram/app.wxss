/* 全局深空主题配色 */
page {
  --bg-primary: #000000;
  --bg-secondary: #050508;
  --color-cyan: #00d2ff;
  --color-cyan-glow: rgba(0, 210, 255, 0.5);
  --color-red: #ff0055;
  --color-orange: #ff9900;
  --color-purple: #9d00ff;
  --color-green: #07c160;
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.5);
  --text-muted: rgba(255, 255, 255, 0.3);
  --border-subtle: rgba(255, 255, 255, 0.1);
  
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 全局样式重置 */
page, view, text, button, image {
  box-sizing: border-box;
}

/* 扫描线动画 */
@keyframes scanline {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100vh); }
}

/* 脉冲发光动画 */
@keyframes pulse-glow {
  0%, 100% { 
    box-shadow: 0 0 15px rgba(0, 210, 255, 0.3), 0 0 30px rgba(0, 210, 255, 0.1);
  }
  50% { 
    box-shadow: 0 0 25px rgba(0, 210, 255, 0.6), 0 0 50px rgba(0, 210, 255, 0.2);
  }
}

/* 闪烁动画 */
@keyframes twinkle {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 淡入动画 */
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 浮动动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* 渐变文字 */
.text-gradient-cyan {
  background: linear-gradient(180deg, #fff 0%, var(--color-cyan) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 按钮基础样式 */
.btn-primary {
  background: linear-gradient(135deg, rgba(0, 210, 255, 0.2) 0%, rgba(0, 210, 255, 0.05) 100%);
  border: 1px solid rgba(0, 210, 255, 0.5);
  border-radius: 4rpx;
  position: relative;
  overflow: hidden;
}

.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.btn-primary:active::before {
  left: 100%;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.1);
}
