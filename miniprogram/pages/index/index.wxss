/* ========== 动画定义 ========== */
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(0, 210, 255, 0.3), 0 0 40rpx rgba(0, 210, 255, 0.1); }
  50% { box-shadow: 0 0 30rpx rgba(0, 210, 255, 0.5), 0 0 60rpx rgba(0, 210, 255, 0.2); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes scanline {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100vh); }
}

@keyframes glitch {
  0%, 90%, 100% { transform: translate(0); }
  92% { transform: translate(-2rpx, 2rpx); }
  94% { transform: translate(2rpx, -2rpx); }
  96% { transform: translate(-2rpx, -2rpx); }
  98% { transform: translate(2rpx, 2rpx); }
}

@keyframes border-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes flicker {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.95; }
}

/* ========== 页面容器 ========== */
.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 100rpx 48rpx 60rpx;
  z-index: 10;
  background: 
    /* 扫描线纹理 */
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2rpx,
      rgba(0, 210, 255, 0.03) 2rpx,
      rgba(0, 210, 255, 0.03) 4rpx
    ),
    /* 噪点纹理 */
    radial-gradient(ellipse at center, rgba(5, 5, 8, 0) 0%, rgba(0, 0, 0, 0.4) 100%);
}

/* 扫描线动画 */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(0, 210, 255, 0.1), 
    rgba(0, 210, 255, 0.3), 
    rgba(0, 210, 255, 0.1), 
    transparent
  );
  animation: scanline 4s linear infinite;
  pointer-events: none;
  z-index: 1;
}

/* ========== 头部区域 ========== */
.header {
  display: flex;
  justify-content: center;
  padding-top: 60rpx;
  position: relative;
}

/* 角落装饰 */
.header::before,
.header::after {
  content: '';
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(0, 210, 255, 0.3);
}

.header::before {
  top: 40rpx;
  left: 20rpx;
  border-right: none;
  border-bottom: none;
}

.header::after {
  top: 40rpx;
  right: 20rpx;
  border-left: none;
  border-bottom: none;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  position: relative;
  animation: float 6s ease-in-out infinite;
}

/* 主标题 - 科技感发光效果 */
.title-main {
  font-size: 88rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 20rpx;
  text-shadow: 
    0 0 20rpx rgba(0, 210, 255, 0.5),
    0 0 40rpx rgba(0, 210, 255, 0.3),
    0 0 80rpx rgba(0, 210, 255, 0.1);
  animation: flicker 4s ease-in-out infinite;
  position: relative;
}

/* 标题下划线装饰 */
.title-main::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 3rpx;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(0, 210, 255, 0.8), 
    transparent
  );
}

/* 副标题 */
.title-sub-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.line {
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.5), transparent);
}

.title-sub {
  font-size: 24rpx;
  color: rgba(0, 210, 255, 0.7);
  letter-spacing: 12rpx;
  font-weight: 400;
  text-transform: uppercase;
}

/* ========== 版本号 ========== */
.version-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: rgba(0, 210, 255, 0.4);
  letter-spacing: 2rpx;
  font-family: monospace;
}

/* ========== 主操作区域 ========== */
.main-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding-bottom: 60rpx;
  position: relative;
}

/* 主按钮 - 赛博朋克风格 */
.btn-primary {
  width: 520rpx;
  height: 120rpx;
  background: 
    linear-gradient(135deg, rgba(0, 210, 255, 0.1) 0%, rgba(0, 210, 255, 0.05) 100%);
  border: 2rpx solid rgba(0, 210, 255, 0.5);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
  animation: pulse-glow 2s ease-in-out infinite;
}

.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(0, 210, 255, 0.2), 
    transparent
  );
  transition: left 0.5s ease;
}

.btn-primary:active::before {
  left: 100%;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background: rgba(0, 210, 255, 0.15);
  border-color: rgba(0, 210, 255, 0.8);
  transform: scale(0.98);
}

/* 按钮边框流动效果 */
.btn-primary {
  background: 
    linear-gradient(135deg, rgba(0, 210, 255, 0.1) 0%, rgba(0, 210, 255, 0.05) 100%),
    linear-gradient(90deg, 
      rgba(0, 210, 255, 0.3), 
      rgba(0, 210, 255, 0.8), 
      rgba(0, 210, 255, 0.3)
    );
  background-size: 100% 100%, 200% 100%;
  background-position: 0 0, 0% 50%;
  animation: pulse-glow 2s ease-in-out infinite, border-flow 3s ease infinite;
}

/* 播放图标 - 三角形 */
.play-icon {
  width: 0;
  height: 0;
  border-left: 24rpx solid rgba(0, 210, 255, 0.9);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  margin-left: 8rpx;
  filter: drop-shadow(0 0 8rpx rgba(0, 210, 255, 0.5));
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 12rpx;
  text-transform: uppercase;
}

/* 按钮提示文字 */
.btn-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 4rpx;
}

/* ========== 底部区域 ========== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  position: relative;
}

/* 底部装饰线 */
.footer::before {
  content: '';
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.3), transparent);
}

/* 次要操作按钮组 */
.secondary-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  width: 100%;
}

/* 次要按钮 - 文字链接风格 */
.btn-secondary {
  background: transparent;
  border: none;
  padding: 16rpx 32rpx;
  position: relative;
  transition: all 0.2s ease;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary::before {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 1rpx;
  background: rgba(0, 210, 255, 0.6);
  transition: width 0.3s ease;
}

.btn-secondary:active::before {
  width: 80%;
}

.btn-secondary-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 4rpx;
  transition: color 0.2s ease;
}

.btn-secondary:active .btn-secondary-text {
  color: rgba(0, 210, 255, 0.9);
}

/* 法律信息 */
.legal-info {
  margin-top: 8rpx;
}

.beian {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 2rpx;
  transition: color 0.2s ease;
}

.beian:active {
  color: rgba(255, 255, 255, 0.6);
}

/* ========== 弹窗样式 ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(5, 5, 8, 0.98);
  backdrop-filter: blur(40rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

/* 弹窗内容 - 终端风格 */
.modal-content {
  position: relative;
  width: 85%;
  max-width: 560rpx;
  background: 
    linear-gradient(180deg, rgba(20, 20, 25, 0.98) 0%, rgba(10, 10, 15, 0.98) 100%);
  border-radius: 4rpx;
  border: 1rpx solid rgba(0, 210, 255, 0.2);
  overflow: hidden;
  transform: scale(0.9) translateY(40rpx);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 
    0 0 60rpx rgba(0, 0, 0, 0.8),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

/* 弹窗扫描线 */
.modal-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2rpx,
    rgba(0, 210, 255, 0.02) 2rpx,
    rgba(0, 210, 255, 0.02) 4rpx
  );
  pointer-events: none;
  z-index: 1;
}

/* 弹窗角落装饰 */
.modal-content::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 40rpx;
  height: 40rpx;
  border-top: 2rpx solid rgba(0, 210, 255, 0.5);
  border-left: 2rpx solid rgba(0, 210, 255, 0.5);
}

.modal.show .modal-content {
  transform: scale(1) translateY(0);
}

.modal-large {
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 80rpx;
  border-bottom: 1rpx solid rgba(0, 210, 255, 0.1);
  position: relative;
  background: rgba(0, 210, 255, 0.03);
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0, 210, 255, 0.9);
  letter-spacing: 8rpx;
  text-transform: uppercase;
}

/* 标题栏内联关闭按钮 */
.btn-close-inline {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: rgba(255, 255, 255, 0.4);
  font-size: 36rpx;
  padding: 0;
  line-height: 1;
  border: none;
  transition: all 0.2s ease;
}

.btn-close-inline::after {
  border: none;
}

.btn-close-inline:active {
  color: rgba(255, 255, 255, 0.9);
  transform: translateY(-50%) scale(0.9);
}

.modal-body {
  padding: 40rpx 32rpx;
  max-height: 55vh;
  position: relative;
}

/* ========== 二维码样式 ========== */
.qrcode-scroll {
  max-height: 60vh;
}

.qrcode-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.qrcode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: rgba(0, 210, 255, 0.03);
  border: 1rpx solid rgba(0, 210, 255, 0.1);
  border-radius: 4rpx;
  position: relative;
}

/* 二维码项角落装饰 */
.qrcode-item::before {
  content: '';
  position: absolute;
  top: -1rpx;
  right: -1rpx;
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid rgba(0, 210, 255, 0.4);
  border-right: 2rpx solid rgba(0, 210, 255, 0.4);
}

.qrcode-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  letter-spacing: 6rpx;
}

.qrcode-image {
  width: 280rpx;
  height: 280rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.5);
}

.qrcode-desc {
  font-size: 22rpx;
  color: rgba(0, 210, 255, 0.5);
  letter-spacing: 3rpx;
}

/* ========== 用户协议样式 ========== */
.disclaimer-scroll {
  max-height: 50vh;
}

.disclaimer-section {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.disclaimer-section:last-child {
  border-bottom: none;
}

.disclaimer-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(0, 210, 255, 0.8);
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.disclaimer-title::before {
  content: '> ';
  color: rgba(0, 210, 255, 0.5);
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.8;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.disclaimer-text.warning {
  color: rgba(252, 165, 165, 0.9);
  background: rgba(252, 165, 165, 0.05);
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  border-left: 3rpx solid rgba(252, 165, 165, 0.5);
}

/* ========== 响应式调整 ========== */
@media (min-height: 800px) {
  .container {
    padding: 140rpx 60rpx 80rpx;
  }
  
  .title-main {
    font-size: 100rpx;
  }
  
  .btn-primary {
    width: 560rpx;
    height: 130rpx;
  }
}
