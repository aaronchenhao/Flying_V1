/* 页面容器 */
.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 120rpx 60rpx 80rpx;
  z-index: 10;
}

/* 头部区域 */
.header {
  display: flex;
  justify-content: center;
  padding-top: 80rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

/* 主标题 - 白色粗体 */
.title-main {
  font-size: 96rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 16rpx;
}

/* 副标题 - 带横线装饰 */
.title-sub-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.line {
  width: 60rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.title-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 16rpx;
  font-weight: 400;
}

/* 主操作区域 */
.main-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding-bottom: 40rpx;
}

/* 主按钮 - 白色背景 */
.btn-primary {
  width: 560rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  transition: all 0.2s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 播放图标 */
.play-icon {
  width: 0;
  height: 0;
  border-left: 20rpx solid #000;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  margin-left: 8rpx;
}

.btn-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #000;
  letter-spacing: 8rpx;
}

/* 底部区域 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

/* 次要操作按钮组 */
.secondary-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

/* 次要按钮 - 透明背景细边框 */
.btn-secondary {
  width: 560rpx;
  height: 100rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.4);
}

.btn-secondary-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 6rpx;
}

/* 法律信息 */
.legal-info {
  margin-top: 16rpx;
}

.beian {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  transition: color 0.2s ease;
}

.beian:active {
  color: rgba(255, 255, 255, 0.7);
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

/* 弹窗内容 */
.modal-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  max-height: 75vh;
  background: rgba(30, 30, 30, 0.95);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  transform: scale(0.95) translateY(20rpx);
  transition: all 0.3s ease;
}

/* 弹窗内关闭按钮 */
.btn-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: rgba(255, 255, 255, 0.6);
  font-size: 36rpx;
  padding: 0;
  line-height: 1;
  border: none;
  z-index: 10;
  transition: all 0.2s ease;
}

.btn-close::after {
  border: none;
}

.btn-close:active {
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
}

.modal-large {
  max-height: 80vh;
}

.modal.show .modal-content {
  transform: scale(1) translateY(0);
}

.modal-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 80rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
}

/* 标题栏内联关闭按钮 */
.btn-close-inline {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: rgba(255, 255, 255, 0.5);
  font-size: 32rpx;
  padding: 0;
  line-height: 1;
  border: none;
  transition: all 0.2s ease;
}

.btn-close-inline::after {
  border: none;
}

.btn-close-inline:active {
  color: rgba(255, 255, 255, 0.9);
}

.modal-body {
  padding: 32rpx;
  max-height: 55vh;
}

/* 二维码列表 */
.qrcode-scroll {
  max-height: 60vh;
}

.qrcode-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.qrcode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.qrcode-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  letter-spacing: 4rpx;
}

.qrcode-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  background: #fff;
}

.qrcode-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
}

/* 用户协议滚动区域 */
.disclaimer-scroll {
  max-height: 50vh;
}

.disclaimer-section {
  margin-bottom: 28rpx;
}

.disclaimer-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  display: block;
  letter-spacing: 2rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.7;
  display: block;
  margin-bottom: 12rpx;
}

.disclaimer-text.warning {
  color: rgba(252, 165, 165, 0.95);
  background: rgba(252, 165, 165, 0.08);
  padding: 20rpx;
  border-radius: 12rpx;
}
