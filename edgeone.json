{
  "build": {
    "command": "npm run build && echo '=== Build Output ===' && find dist -type f && echo '=== File Sizes ===' && du -sh dist/*",
    "outputDir": "dist"
  },
  "include": [
    "dist/**/*"
  ],
  "routes": [
    {
      "path": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "path": "/*",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
