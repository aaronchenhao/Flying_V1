{
  "build": {
    "command": "npm run build && echo '=== Build Output ===' && find dist -type f && echo '=== File Sizes ===' && du -sh dist/*",
    "outputDir": "dist"
  },
  "include": [
    "dist/**/*",
    "dist/assets/**/*"
  ],
  "routes": [
    {
      "path": "/Flying_V1/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "path": "/Flying_V1/*",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "path": "/Flying_V1",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
