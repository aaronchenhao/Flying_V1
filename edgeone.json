{
  "build": {
    "command": "npm run build && ls -la dist/ && ls -la dist/assets/",
    "outputDir": "dist",
    "include": [
      "dist/**/*"
    ]
  },
  "routes": [
    {
      "path": "/Flying_V1/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "path": "/Flying_V1/*",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "path": "/Flying_V1",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
